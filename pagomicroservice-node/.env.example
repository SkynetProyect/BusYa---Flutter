# Prefer DATABASE_URL, fallback SUPABASE_DB_URL (jdbc: stripped automatically)
# Example: postgres://user:password@host:5432/dbname
DATABASE_URL=
# Or, if you only have jdbc-style url from Supabase:
SUPABASE_DB_URL=
# Enable SSL if your provider requires it (e.g. true on many PaaS)
DB_SSL=false
# Local dev port
PORT=3000
